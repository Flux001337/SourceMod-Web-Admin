                "target": {
                    "label": {"en": "Player", "de": "Spieler"},
                    "placeholder": {"en": "#userid or name", "de": "#userid oder Name"},
                    "quote": true,
                    "suggest": "player"
                },
                "state": {
                    "label": {"en": "On/off (empty = toggle)", "de": "An/aus (leer = umschalten)"},
                    "options": ["1", "0"],
